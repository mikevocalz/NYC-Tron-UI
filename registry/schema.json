{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mikevocalz/NYC-Tron-UI/main/registry/schema.json",
  "title": "NYC-Tron UI agent component registry",
  "description": "Generated by tooling/llms.mjs from docs/library/components.json and the documentation catalog. One item per public component export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "name",
    "title",
    "homepage",
    "description",
    "distribution",
    "generatedBy",
    "skill",
    "inputs",
    "ownerConfirmation",
    "status",
    "platformPolicy",
    "evidenceRecords",
    "summary",
    "guides",
    "groups",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "note"
      ],
      "properties": {
        "kind": {
          "const": "package-imports"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "generatedBy": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "ownerConfirmation": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed"
      ]
    },
    "status": {
      "type": "string"
    },
    "platformPolicy": {
      "type": "object"
    },
    "evidenceRecords": {
      "type": "object"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentCount",
        "preferredImportCount",
        "groupCount",
        "proposedStable",
        "proposedPreview"
      ],
      "properties": {
        "componentCount": {
          "type": "integer"
        },
        "preferredImportCount": {
          "type": "integer"
        },
        "groupCount": {
          "type": "integer"
        },
        "proposedStable": {
          "type": "integer"
        },
        "proposedPreview": {
          "type": "integer"
        }
      }
    },
    "guides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guide"
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "title",
        "description",
        "sections"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "paragraphs",
              "links"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "paragraphs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "code": {
                "type": "string"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "href"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "href": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "importPrefix",
        "categories",
        "docs",
        "count",
        "preferredCount",
        "symbols"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "importPrefix": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "docs": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "preferredCount": {
          "type": "integer"
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "title",
        "symbol",
        "description",
        "package",
        "importPath",
        "import",
        "preferred",
        "preferredId",
        "aliases",
        "category",
        "group",
        "docs",
        "stability",
        "platforms",
        "platformEvidence",
        "props",
        "propsFrom",
        "inheritedProps",
        "otherContracts",
        "signatures",
        "example",
        "accessibility",
        "declarationIdentities"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique slug, shared with the documentation site route."
        },
        "id": {
          "type": "string",
          "description": "Inventory id: import path, #, exported symbol."
        },
        "title": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "importPath": {
          "type": "string"
        },
        "import": {
          "type": "string",
          "description": "Exact import statement for this export."
        },
        "preferred": {
          "type": "boolean",
          "description": "False for a package-root (barrel) export that has a subpath alias; use preferredId instead."
        },
        "preferredId": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "general components",
            "professional controls"
          ]
        },
        "group": {
          "type": "string"
        },
        "docs": {
          "type": "string"
        },
        "stability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "proposed",
            "ownerConfirmation",
            "reason"
          ],
          "properties": {
            "label": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "stable",
                "preview",
                null
              ]
            },
            "proposed": {
              "type": "string",
              "enum": [
                "stable",
                "preview"
              ]
            },
            "ownerConfirmation": {
              "type": "string",
              "enum": [
                "pending",
                "confirmed"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "platforms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ios",
            "android",
            "web",
            "macos",
            "windows",
            "visionos",
            "quest",
            "pico"
          ],
          "properties": {
            "ios": {
              "type": "string",
              "enum": [
                "supported",
                "struck",
                "not verified"
              ]
            },
            "android": {
              "type": "string",
              "enum": [
                "supported",
                "struck",
                "not verified"
              ]
            },
            "web": {
              "type": "string",
              "enum": [
                "supported",
                "struck",
                "not verified"
              ]
            },
            "macos": {
              "type": "string",
              "enum": [
                "supported",
                "struck",
                "not verified"
              ]
            },
            "windows": {
              "type": "string",
              "enum": [
                "supported",
                "struck",
                "not verified"
              ]
            },
            "visionos": {
              "type": "string",
              "enum": [
                "supported",
                "struck",
                "not verified"
              ]
            },
            "quest": {
              "type": "string",
              "enum": [
                "supported",
                "struck",
                "not verified"
              ]
            },
            "pico": {
              "type": "string",
              "enum": [
                "supported",
                "struck",
                "not verified"
              ]
            }
          }
        },
        "platformEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "required"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "variant": {
                "const": true
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "propsFrom": {
          "type": "string"
        },
        "inheritedProps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "from",
            "sources"
          ],
          "properties": {
            "count": {
              "type": "integer"
            },
            "from": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "otherContracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "reason"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "code",
            "limitations"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prop",
                  "type",
                  "note"
                ],
                "properties": {
                  "prop": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "accessibility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "declarationIdentities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
