{
  "schemaVersion": 1,
  "input": {
    "pathResolver": "GetTempPathW(MAX_PATH + 1); no fallback; combined UTF-16 path length strictly less than MAX_PATH",
    "filename": "nyctron-startup-<sourceRevision>-<processId>-<creationFileTime>.jsonl",
    "creation": "CREATE_NEW",
    "desiredAccess": "GENERIC_WRITE",
    "shareMode": "FILE_SHARE_READ",
    "securityAttributes": "nullptr (non-inherited)",
    "flags": "FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT",
    "handleLifetime": "Process exit closes the handle; cap/write failure disables writes but retains exclusive write/delete ownership until exit",
    "encoding": "ASCII JSONL with LF; no BOM"
  },
  "limits": {
    "records": 64,
    "bytes": 16384,
    "recordBytes": 512,
    "ordinaryRecords": 63,
    "consoleBytes": 8192
  },
  "fields": {
    "schemaVersion": "integer exactly 1",
    "sourceRevision": "lowercase 40-hex current checkout",
    "processId": "integer in 1..UINT32_MAX",
    "creationFileTime": "canonical nonzero decimal UInt64 string from GetProcessTimes of writer",
    "sequence": "integer 1..64, contiguous",
    "threadId": "integer in 1..UINT32_MAX",
    "stage": "exact fixed enum below",
    "contentionObservedThroughRow": "boolean, known try-lock failure observed before this row; later drops and process-wide total unknown"
  },
  "stages": [
    "configure-entry",
    "observer-factory-before",
    "observer-constructor-body-entry",
    "observer-process-times-before",
    "observer-process-times-returned",
    "observer-creation-string-before",
    "observer-creation-string-returned",
    "observer-session-guid-before",
    "observer-session-guid-returned",
    "observer-session-string-before",
    "observer-session-string-returned",
    "application-data-before",
    "application-data-returned",
    "observer-prefix-before",
    "observer-prefix-returned",
    "message-registration-before",
    "message-registration-returned",
    "observer-constructor-body-exit",
    "observer-factory-returned",
    "property-set-before",
    "property-set-returned",
    "configure-exception",
    "hook-key-before",
    "hook-key-returned",
    "hook-constructor-body-entry",
    "hook-constructor-body-exit",
    "hook-register-entry",
    "hook-register-returned",
    "hook-register-unavailable",
    "hook-register-exception",
    "observer-register-entry",
    "register-projection-before",
    "register-projection-returned",
    "register-context-before",
    "register-context-returned",
    "register-dispatcher-before",
    "register-dispatcher-returned",
    "register-owner-before",
    "register-owner-returned",
    "register-ticket-before",
    "register-ticket-returned",
    "register-subclass-before",
    "register-subclass-returned",
    "register-ready-before",
    "register-ready-returned",
    "observer-register-returned",
    "window-message-entry",
    "window-message-scope-exit",
    "trace-limit"
  ],
  "limitsAndAbsence": "trace-limit replaces the triggering stage and is terminal if successfully written. No finalized footer. Absent file, missing stage, partial tail, write failure, path mismatch, cap and trace perturbation cannot establish a causal callee or prove Configure was not entered.",
  "scope": "Private fixture startup observation; no source/reference/CI updates; no successful native acceptance implied."
}
