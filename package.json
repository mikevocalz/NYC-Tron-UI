{
  "name": "nyc-tron-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Platform-native-capable and theme-agnostic UI component foundation",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test packages/core/tests/*.test.mjs packages/geometry/tests/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm test && pnpm typecheck"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/react": "~19.3.0"
  }
}
