{
  "name": "@nyc-tron/hardware-keys",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikevocalz/NYC-Tron-UI.git",
    "directory": "packages/hardware-keys"
  },
  "homepage": "https://github.com/mikevocalz/NYC-Tron-UI/tree/main/packages/hardware-keys#readme",
  "bugs": {
    "url": "https://github.com/mikevocalz/NYC-Tron-UI/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "Hardware keyboard shortcuts for NYC-Tron UI: UIKeyCommand and UIPress capture on iOS, unhandled KeyEvent listeners on Android, document keydown on web",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "react-native": "./dist/index.native.js",
      "default": "./dist/index.js"
    },
    "./payload": {
      "types": "./dist/payload.d.ts",
      "react-native": "./dist/payload.js",
      "default": "./dist/payload.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@nyc-tron/ui": "workspace:^",
    "expo": "^58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0"
  },
  "devDependencies": {
    "@nyc-tron/ui": "workspace:*",
    "@types/react": "~19.3.0",
    "@typescript/typescript6": "6.0.2",
    "expo": "58.0.24",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "ios",
    "android/build.gradle",
    "android/src",
    "expo-module.config.json",
    "README.md",
    "LICENSE",
    "Package.swift",
    "THIRD_PARTY_NOTICES.md"
  ]
}
