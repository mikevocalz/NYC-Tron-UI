{
  "name": "@nyc-tron/icons",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikevocalz/NYC-Tron-UI.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/mikevocalz/NYC-Tron-UI/tree/main/packages/icons#readme",
  "bugs": {
    "url": "https://github.com/mikevocalz/NYC-Tron-UI/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "Original cross-platform outline/filled and Rive-ready editor icon system extracted from Nitro Forge",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/TronIcon.d.ts",
      "react-native": "./dist/TronIcon.js",
      "default": "./dist/TronIcon.js"
    },
    "./web": {
      "types": "./dist/TronIcon.d.ts",
      "react-native": "./dist/TronIcon.js",
      "default": "./dist/TronIcon.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "react-native": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./glyphs": {
      "types": "./dist/glyphs.d.ts",
      "react-native": "./dist/glyphs.js",
      "default": "./dist/glyphs.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "react-native": "./dist/state.js",
      "default": "./dist/state.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "react-native": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "node --check src/ForgeIcon.js && node --check src/TronIcon.js && node --check src/catalog.js && node --check src/glyphs.js && node --check src/state.js && node --check src/tokens.js && node --check src/index.js && tsc --project tsconfig.json",
    "test": "node --test tests/*.test.js",
    "build": "node -e \"const f=require('node:fs');f.rmSync('dist',{recursive:true,force:true});f.cpSync('src','dist',{recursive:true})\""
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.85.0",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  }
}
