{
  "name": "@nyc-tron/macos-appkit",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Isolated Spark 0.0.2 AppKit controls and shared window lifecycle binding",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikevocalz/NYC-Tron-UI.git",
    "directory": "packages/macos-appkit/spark"
  },
  "main": "./dist/window-controller.js",
  "types": "./dist/window-controller.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/window-controller.d.ts",
      "default": "./dist/window-controller.js"
    },
    "./window-controller": {
      "types": "./dist/window-controller.d.ts",
      "default": "./dist/window-controller.js"
    },
    "./windows": {
      "types": "./dist/windows.d.ts",
      "react-native": "./src/windows.ts",
      "default": "./dist/windows.js"
    },
    "./window-chrome": {
      "types": "./dist/window-chrome.d.ts",
      "react-native": "./src/window-chrome.ts",
      "default": "./dist/window-chrome.js"
    },
    "./sidebar": {
      "types": "./dist/sidebar.d.ts",
      "react-native": "./src/sidebar.tsx",
      "default": "./dist/sidebar.js"
    },
    "./split-view": {
      "types": "./dist/split-view.d.ts",
      "react-native": "./src/split-view.tsx",
      "default": "./dist/split-view.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "react-native": "./src/button.tsx",
      "default": "./dist/button.js"
    },
    "./text-field": {
      "types": "./dist/text-field.d.ts",
      "react-native": "./src/text-field.tsx",
      "default": "./dist/text-field.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "react-native": "./src/select.tsx",
      "default": "./dist/select.js"
    },
    "./segmented-control": {
      "types": "./dist/segmented-control.d.ts",
      "react-native": "./src/segmented-control.tsx",
      "default": "./dist/segmented-control.js"
    },
    "./drag-drop": {
      "types": "./dist/drag-drop.d.ts",
      "react-native": "./src/drag-drop.tsx",
      "default": "./dist/drag-drop.js"
    },
    "./menus": {
      "types": "./dist/menus.d.ts",
      "react-native": "./src/menus.ts",
      "default": "./dist/menus.js"
    },
    "./context-menu": {
      "types": "./dist/context-menu.d.ts",
      "react-native": "./src/context-menu.ts",
      "default": "./dist/context-menu.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "react-native": "./src/tooltip.tsx",
      "default": "./dist/tooltip.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "react-native": "./src/popover.tsx",
      "default": "./dist/popover.js"
    },
    "./anchored-inspector": {
      "types": "./dist/anchored-inspector.d.ts",
      "react-native": "./src/anchored-inspector.tsx",
      "default": "./dist/anchored-inspector.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "macos",
    "*.podspec",
    "react-native.config.cjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scripts/check-package.mjs"
  ],
  "peerDependencies": {
    "@nyc-tron/core": "1.0.0-rc.1",
    "@legendapp/spark": "0.0.2",
    "expo": "55.0.32",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-macos": "0.83.0",
    "react-native-nitro-modules": "0.37.0"
  },
  "codegenConfig": {
    "name": "NYCTronAppKitSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "ios": {
      "componentProvider": {
        "NYCTronPopover": "NYCTronPopoverComponentView"
      },
      "modulesProvider": {
        "NativeNYCTronDisplays": "NYCTronDisplays"
      }
    }
  },
  "spark": {
    "nativeModules": [
      "NativeNYCTronDisplays"
    ],
    "pod": "NYCTronAppKit",
    "platforms": [
      "macos"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "node --test tests/*.test.mjs",
    "prepack": "node scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
