{
  "name": "@nyc-tron/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "react-native": "./dist/navigation.js",
      "default": "./dist/navigation.js"
    },
    "./folds": {
      "types": "./dist/folds.d.ts",
      "react-native": "./dist/folds.js",
      "default": "./dist/folds.js"
    },
    "./spatial": {
      "types": "./dist/spatial.d.ts",
      "react-native": "./dist/spatial.js",
      "default": "./dist/spatial.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "react-native": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./spatial-interactions": {
      "types": "./dist/spatial-interactions.d.ts",
      "react-native": "./dist/spatial-interactions.js",
      "default": "./dist/spatial-interactions.js"
    },
    "./advanced-catalog": {
      "types": "./dist/advanced-catalog.d.ts",
      "react-native": "./dist/advanced-catalog.js",
      "default": "./dist/advanced-catalog.js"
    },
    "./presets/infrax": {
      "types": "./dist/presets/infrax.d.ts",
      "react-native": "./dist/presets/infrax.js",
      "default": "./dist/presets/infrax.js"
    },
    "./pane-plan": {
      "types": "./dist/pane-plan.d.ts",
      "react-native": "./dist/pane-plan.js",
      "default": "./dist/pane-plan.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ]
}
