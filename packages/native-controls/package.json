{
  "name": "@nyc-tron/native-controls",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikevocalz/NYC-Tron-UI.git",
    "directory": "packages/native-controls"
  },
  "homepage": "https://github.com/mikevocalz/NYC-Tron-UI/tree/main/packages/native-controls#readme",
  "bugs": {
    "url": "https://github.com/mikevocalz/NYC-Tron-UI/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "Installable SwiftUI and Jetpack Compose instruments for NYC-Tron UI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ArcKnob": {
      "types": "./dist/ArcKnob.d.ts",
      "react-native": "./dist/ArcKnob.js",
      "default": "./dist/ArcKnob.js"
    },
    "./XYPad": {
      "types": "./dist/XYPad.d.ts",
      "react-native": "./dist/XYPad.js",
      "default": "./dist/XYPad.js"
    },
    "./DisplayP3DiscLayer": {
      "types": "./dist/DisplayP3DiscLayer.d.ts",
      "react-native": "./dist/DisplayP3DiscLayer.js",
      "default": "./dist/DisplayP3DiscLayer.js"
    },
    "./NativeVideoPlayer": {
      "types": "./dist/NativeVideoPlayer.d.ts",
      "react-native": "./dist/NativeVideoPlayer.js",
      "default": "./dist/NativeVideoPlayer.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@expo/ui": "^58.0.0",
    "expo": ">=58.0.21",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0"
  },
  "devDependencies": {
    "@expo/ui": "58.0.27",
    "expo": "58.0.23",
    "react": "19.3.0",
    "@types/react": "~19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3"
  },
  "files": [
    "dist",
    "ios",
    "android",
    "expo-module.config.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "Package.swift"
  ]
}
