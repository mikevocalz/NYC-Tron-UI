      "react-native": "./dist/components/NavigationRail",
      "default": "./dist/components/NavigationRail.js"
    },
    "./components/forge/WaveformLane": {
      "types": "./dist/components/forge/WaveformLane.d.ts",
      "react-native": "./dist/components/forge/WaveformLane",
      "default": "./dist/components/forge/WaveformLane.js"
    },
    "./components/forge/NativeSeekBar": {
      "types": "./dist/components/forge/NativeSeekBar.d.ts",
      "react-native": "./dist/components/forge/NativeSeekBar",
      "default": "./dist/components/forge/NativeSeekBar.js"
