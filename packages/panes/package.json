{
  "name": "@nyc-tron/panes",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikevocalz/NYC-Tron-UI.git",
    "directory": "packages/panes"
  },
  "homepage": "https://github.com/mikevocalz/NYC-Tron-UI/tree/main/packages/panes#readme",
  "bugs": {
    "url": "https://github.com/mikevocalz/NYC-Tron-UI/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "Adaptive Master Detail Inspector React Native layout independently installable from NYC-Tron",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./AdaptivePaneHost": {
      "types": "./dist/components/AdaptivePaneHost.d.ts",
      "react-native": "./dist/components/AdaptivePaneHost.js",
      "default": "./dist/components/AdaptivePaneHost.js"
    },
    "./SafeAreaFoldableLayout": {
      "types": "./dist/components/SafeAreaFoldableLayout.d.ts",
      "react-native": "./dist/components/SafeAreaFoldableLayout.js",
      "default": "./dist/components/SafeAreaFoldableLayout.js"
    },
    "./window-lifecycle": {
      "types": "./dist/window-lifecycle.d.ts",
      "react-native": "./dist/window-lifecycle.js",
      "default": "./dist/window-lifecycle.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@nyc-tron/core": "workspace:^",
    "react": ">=19.0.0",
    "react-native": ">=0.85.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@nyc-tron/core": "workspace:*",
    "typescript": "~6.0.3",
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "zustand": "5.0.16"
  }
}
