{
  "name": "@nyc-tron/windows-fluent",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikevocalz/NYC-Tron-UI.git",
    "directory": "packages/windows-fluent"
  },
  "homepage": "https://github.com/mikevocalz/NYC-Tron-UI/tree/main/packages/windows-fluent#readme",
  "bugs": {
    "url": "https://github.com/mikevocalz/NYC-Tron-UI/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "Typed native WinUI 3 NavigationView shell contract for a standalone React Native Windows host",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "windows",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./controller": {
      "types": "./dist/controller.d.ts",
      "react-native": "./dist/controller.js",
      "default": "./dist/controller.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "react-native": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
