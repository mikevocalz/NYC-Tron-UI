{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "react"
    ]
  },
  "include": [
    "App.tsx",
    "route-store.ts",
    "desktop-store.ts",
    "NativeOverlays.tsx",
    "overlay-store.ts",
    "NativeDrag.tsx",
    "drag-store.ts"
  ]
}
