{
  "name": "@nyc-tron/windows-fluent-fabric",
  "version": "0.1.0",
  "private": true,
  "description": "RNW 0.85 Windows XAML Fabric NavigationView island",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "reactNativeConfig": {
    "windows": "windows"
  },
  "codegenConfig": {
    "name": "NYCTronFluentFabric",
    "type": "all",
    "jsSrcsDir": "src",
    "windows": {
      "generators": [
        "componentsWindows"
      ],
      "namespace": "winrt::NYCTronFluentFabric::Codegen",
      "outputDirectory": "windows/NYCTronFluentFabric/codegen"
    }
  },
  "scripts": {
    "codegen": "react-native codegen-windows",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react-native": "0.85.3",
    "react-native-windows": "0.85.0",
    "react": ">=19.2.0"
  },
  "devDependencies": {
    "react-native": "0.85.3",
    "react-native-windows": "0.85.0",
    "react": "19.2.3",
    "@types/react": "^19.2.0",
    "@react-native-community/cli": "20.0.0",
    "typescript": "~5.9.3"
  }
}
