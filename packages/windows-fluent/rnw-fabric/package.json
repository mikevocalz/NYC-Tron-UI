{
  "name": "@nyc-tron/windows-fluent-fabric",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikevocalz/NYC-Tron-UI.git",
    "directory": "packages/windows-fluent/rnw-fabric"
  },
  "homepage": "https://github.com/mikevocalz/NYC-Tron-UI/tree/main/packages/windows-fluent/rnw-fabric#readme",
  "bugs": {
    "url": "https://github.com/mikevocalz/NYC-Tron-UI/issues"
  },
  "description": "RNW 0.85 native WinUI navigation and shared-runtime desktop window hosting",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./navigation-binding": {
      "types": "./dist/navigation-binding.d.ts",
      "react-native": "./src/navigation-binding.ts",
      "default": "./dist/navigation-binding.js"
    },
    "./navigation-host": {
      "types": "./dist/navigation-host.windows.d.ts",
      "react-native": "./src/navigation-host.windows.tsx",
      "default": "./dist/navigation-host.windows.js"
    },
    "./windows": {
      "types": "./dist/windows.d.ts",
      "react-native": "./src/windows.ts",
      "default": "./dist/windows.js"
    },
    "./window-controller": {
      "types": "./dist/window-controller.d.ts",
      "react-native": "./src/window-controller.ts",
      "default": "./dist/window-controller.js"
    },
    "./window-types": {
      "types": "./dist/window-types.d.ts",
      "react-native": "./src/window-types.ts",
      "default": "./dist/window-types.js"
    },
    "./window-chrome": {
      "types": "./dist/window-chrome.d.ts",
      "react-native": "./src/window-chrome.ts",
      "default": "./dist/window-chrome.js"
    },
    "./overlays": {
      "types": "./dist/overlays.windows.d.ts",
      "react-native": "./src/overlays.windows.tsx",
      "default": "./dist/overlays.windows.js"
    },
    "./drag-drop": {
      "types": "./dist/drag-drop.windows.d.ts",
      "react-native": "./src/drag-drop.windows.tsx",
      "default": "./dist/drag-drop.windows.js"
    }
  },
  "files": [
    "dist",
    "src",
    "windows",
    "react-native.config.js",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "licenses"
  ],
  "reactNativeConfig": {
    "windows": "windows"
  },
  "codegenConfig": {
    "name": "NYCTronFluentFabric",
    "type": "all",
    "jsSrcsDir": "src",
    "windows": {
      "generators": [
        "componentsWindows",
        "modulesWindows"
      ],
      "namespace": "winrt::NYCTronFluentFabric::Codegen",
      "outputDirectory": "windows/NYCTronFluentFabric/codegen"
    }
  },
  "scripts": {
    "codegen": "react-native codegen-windows",
    "build": "node scripts/build-peers.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs isolated-tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react-native": "0.85.3",
    "react-native-windows": "0.85.0",
    "react": ">=19.2.0",
    "@nyc-tron/core": "1.0.0-rc.1",
    "@nyc-tron/windows-fluent": "1.0.0-rc.1"
  },
  "devDependencies": {
    "react-native": "0.85.3",
    "react-native-windows": "0.85.0",
    "react": "19.2.3",
    "@types/react": "^19.2.0",
    "@react-native-community/cli": "20.0.0",
    "typescript": "~5.9.3",
    "@nyc-tron/core": "file:../../core",
    "@nyc-tron/windows-fluent": "file:.."
  }
}
