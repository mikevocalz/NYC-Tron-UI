{
  "name": "@nyc-tron/expo-controls",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Optional Expo 58 SwiftUI/Compose picker, action menus, popovers and tooltips for NYC-Tron UI",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "react-native": "./dist/index.native.js",
      "default": "./dist/index.js"
    },
    "./NativeDropdown": {
      "types": "./dist/components/NativeDropdown.d.ts",
      "browser": "./dist/components/NativeDropdown.js",
      "react-native": "./dist/components/NativeDropdown.native.js",
      "default": "./dist/components/NativeDropdown.js"
    },
    "./NativeActionMenu": {
      "types": "./dist/components/NativeActionMenu.web.d.ts",
      "browser": "./dist/components/NativeActionMenu.web.js",
      "react-native": "./dist/components/NativeActionMenu.native.js",
      "default": "./dist/components/NativeActionMenu.web.js"
    },
    "./NativePopover": {
      "types": "./dist/components/NativePopover.web.d.ts",
      "browser": "./dist/components/NativePopover.web.js",
      "react-native": "./dist/components/NativePopover.native.js",
      "default": "./dist/components/NativePopover.web.js"
    },
    "./Tooltip": {
      "types": "./dist/components/Tooltip.web.d.ts",
      "browser": "./dist/components/Tooltip.web.js",
      "react-native": "./dist/components/Tooltip.native.js",
      "default": "./dist/components/Tooltip.web.js"
    },
    "./NativeSliderField": {
      "types": "./dist/components/NativeSliderField.web.d.ts",
      "browser": "./dist/components/NativeSliderField.web.js",
      "react-native": "./dist/components/NativeSliderField.native.js",
      "default": "./dist/components/NativeSliderField.web.js"
    },
    "./NativeSplitButton": {
      "types": "./dist/components/NativeSplitButton.web.d.ts",
      "browser": "./dist/components/NativeSplitButton.web.js",
      "react-native": "./dist/components/NativeSplitButton.native.js",
      "default": "./dist/components/NativeSplitButton.web.js"
    },
    "./ContextMenu": {
      "types": "./dist/components/ContextMenu.web.d.ts",
      "browser": "./dist/components/ContextMenu.web.js",
      "react-native": "./dist/components/ContextMenu.native.js",
      "default": "./dist/components/ContextMenu.web.js"
    },
    "./menu-model": {
      "types": "./dist/components/menu-model.d.ts",
      "react-native": "./dist/components/menu-model.js",
      "default": "./dist/components/menu-model.js"
    },
    "./Select": {
      "types": "./dist/components/Select.web.d.ts",
      "browser": "./dist/components/Select.web.js",
      "react-native": "./dist/components/Select.native.js",
      "default": "./dist/components/Select.web.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@nyc-tron/ui": "workspace:^",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0",
    "@expo/ui": "^58.0.0",
    "expo": "^58.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@nyc-tron/ui": "workspace:*",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "@expo/ui": "58.0.27",
    "expo": "58.0.14",
    "zustand": "5.0.16"
  }
}
