{
  "name": "@nyc-tron/expo-controls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Optional Expo 58 SwiftUI/Compose picker and native action menus for NYC-Tron UI",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./NativeDropdown": {
      "types": "./dist/components/NativeDropdown.d.ts",
      "default": "./dist/components/NativeDropdown.js"
    },
    "./NativeActionMenu": {
      "types": "./dist/components/NativeActionMenu.types.d.ts",
      "react-native": "./dist/components/NativeActionMenu",
      "default": "./dist/components/NativeActionMenu.web.js"
    },
    "./menu-model": {
      "types": "./dist/components/menu-model.d.ts",
      "default": "./dist/components/menu-model.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.88.0",
    "@expo/ui": "^58.0.0",
    "expo": "^58.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "@expo/ui": "58.0.27",
    "expo": "58.0.14",
    "zustand": "5.0.16"
  }
}
